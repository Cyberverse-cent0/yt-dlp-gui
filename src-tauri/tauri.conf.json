{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YDL GUI",
  "version": "1.1.2",
  "identifier": "com.imsyy.yt-dlp-gui",
  "build": {
    "beforeDevCommand": "pnpm web:dev",
    "devUrl": "http://localhost:15688",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YDL GUI",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "YDL GUI"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../browser-extension": "browser-extension"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ytdlp-gui"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Cyberverse-cent0/yt-dlp-gui/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3NEVBOUNGMEM5Q0E1NkUKUldSdXBad016NmxPbHdPRVlWNWQzdjFoeEVUVlV2YTA3aTQxd3o4cVllbWxUSm1NSlFBWEZ2Y1UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
